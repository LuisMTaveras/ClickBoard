<Window x:Class="ClickBoard.App.QuickPasteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClipForge · Selector rápido" Icon="/Assets/ClipForge.ico" Width="790" Height="650" MinWidth="620" MinHeight="420"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}" PreviewKeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="QuickSearch" TargetType="TextBox" BasedOn="{StaticResource SearchBox}" />
        <Style x:Key="QuickPrimaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource QuickSelectedTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickMutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource QuickSelectedMutedBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QuickItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="8" Padding="8,2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource QuickSelectedBrush}" /></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="{DynamicResource QuickHoverBrush}" /></Trigger>
                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Root" Property="Background" Value="{DynamicResource QuickSelectedBrush}" /></MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource DockBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="23">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.35" Color="#000000" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="1,0,1,18" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/ClipForge.ico" Width="31" Height="31" />
                    <StackPanel Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ClipForge" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border CornerRadius="6" Padding="7,2" Margin="9,0,0,0" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCaptureModeBanner}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CaptureModeBanner}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Selector rápido  ·  " FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                            <TextBlock Text="{Binding PasteDestinationHint}" FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource MutedBrush}" Background="Transparent" BorderThickness="0" Width="32" Height="32" Cursor="Hand" Click="Close_Click" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource MutedBrush}" FontSize="16" VerticalAlignment="Center" Margin="14,0,0,0" Panel.ZIndex="1" IsHitTestVisible="False" />
                <TextBox x:Name="SearchBox" Grid.ColumnSpan="2" Style="{StaticResource QuickSearch}" Padding="43,5,14,5" BorderThickness="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Busca en tu historial" />
            </Grid>

            <Grid Grid.Row="2">
                <ListBox ScrollViewer.ScrollChanged="ClipList_ScrollChanged" x:Name="ClipList" ItemsSource="{Binding Clips}" SelectedItem="{Binding SelectedClip}" ItemContainerStyle="{StaticResource QuickItem}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="ClipList_DoubleClick">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid Height="68" Margin="2,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="8" Background="{DynamicResource ThumbnailBrush}" VerticalAlignment="Center"><Image Source="{Binding ThumbnailBytes, Converter={StaticResource BytesToImageConverter}, ConverterParameter=128}" Stretch="UniformToFill" ClipToBounds="True" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,10,0">
                                <TextBlock Text="{Binding ShortPreview}" FontSize="13" Style="{StaticResource QuickPrimaryText}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding KindLabel}" FontSize="10" Style="{StaticResource QuickMutedText}" /><TextBlock Text="  ·  " FontSize="10" Style="{StaticResource QuickMutedText}" /><TextBlock Text="{Binding SourceApp, TargetNullValue=Portapapeles}" FontSize="10" Style="{StaticResource QuickMutedText}" /></StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CreatedAtUtc, StringFormat='{}{0:HH:mm}'}" FontSize="10" Style="{StaticResource QuickMutedText}" VerticalAlignment="Center" Margin="0,0,9,0" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="310" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasClips}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="19" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,13,0,0" TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyDescription}" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" TextAlignment="Center" />
                    <TextBlock Text="Ctrl + C  ·  después busca y pulsa Enter" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" TextAlignment="Center" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="2,16,2,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="↑  ↓" FontSize="11" Foreground="{DynamicResource TextBrush}" /><TextBlock Text="  Navegar" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="7,0,16,0" />
                        <Border Background="{DynamicResource QuickKeyBrush}" CornerRadius="5" Padding="7,3"><TextBlock Text="Enter" FontSize="10" Foreground="{DynamicResource QuickKeyTextBrush}" /></Border><TextBlock Text="{Binding PrimaryPasteLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="QuickActionHint" Grid.Column="1" Text="Enter Pegar · Shift+Enter Texto plano · Ctrl+F Favorito · Esc Cerrar" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>



